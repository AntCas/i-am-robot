{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
	  "@cloudflare/workers-types",
	  "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
