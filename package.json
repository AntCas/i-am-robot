{
  "name": "i-am-robot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run test && node --check site/widget.js && node --check site/widget-logic.js && node --check site/message-board.js && pnpm wrangler deploy --dry-run",
    "cf:bootstrap": "bash scripts/bootstrap-cloudflare.sh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "login": "wrangler login",
    "test": "node --test src/**/*.test.ts site/**/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260415.0",
    "@types/node": "^25.6.2",
    "wrangler": "^4.12.0"
  }
}
